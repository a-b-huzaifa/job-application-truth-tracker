# ==============================================================================
# Job Application Truth Tracker — Environment Configuration
# ==============================================================================

# PostgreSQL Connection String (PostgreSQL 15 via Docker or direct instance)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_tracker

# Express HTTP Server Port
PORT=3000

# JWT Secret for Signing and Verifying Authentication Tokens
# Generate a strong 256-bit random key via:
# node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_bytes

# Google Gemini API Key for LLM Job Fit Analysis
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Destination Directory for Generated PDF Reports
OUTPUT_DIR=./outputs
